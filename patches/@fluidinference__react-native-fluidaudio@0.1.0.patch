+            throw NSError(domain: "FluidAudioModule", code: 2, userInfo: [NSLocalizedDescriptionKey: "Bundled FluidAudio ASR model is incomplete"])
+        }
+        return try await AsrModels.load(from: modelDirectory, version: .v3)
+    }
