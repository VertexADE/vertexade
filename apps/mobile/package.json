{
  "name": "@vertexade/mobile",
  "version": "0.0.21",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "export": "node scripts/hermes-release.mjs --platform all",
    "export:analysis": "expo export --platform all --no-bytecode --source-maps",
    "export:compare": "node scripts/compare-exports.mjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "jest --runInBand",
    "test:ci": "jest --ci --runInBand --coverage --reporters=default --reporters=jest-junit",
    "fixture:device": "node test/device/fixture-server.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.8",
    "@expo/ui": "~57.0.10",
    "@fluidinference/react-native-fluidaudio": "0.1.0",
    "@tanstack/markdown": "0.0.13",
    "@vertexade/platform-client": "workspace:*",
    "@vertexade/platform-contracts": "workspace:*",
    "expo": "^57.0.11",
    "expo-ai-kit": "0.14.0",
    "expo-build-properties": "~57.0.10",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.9",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.2",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image-picker": "~57.0.9",
    "expo-linking": "~57.0.5",
    "expo-notifications": "~57.0.10",
    "expo-paste-input": "0.2.2",
    "expo-router": "^57.0.11",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "^57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-widgets": "~57.0.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-diffs": "^1.0.3",
    "react-native-nitro-modules": "^0.35.10",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "^4.26.2",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.4",
    "hermes-compiler": "250829098.0.16",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.3",
    "jest-junit": "^17.0.0",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3",
    "yaml": "^2.9.0"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/test/setup.ts"
    ],
    "testMatch": [
      "<rootDir>/**/*.(test|spec).(ts|tsx)"
    ],
    "collectCoverageFrom": [
      "app/**/*.{ts,tsx}",
      "src/**/*.{ts,tsx}",
      "!**/*.{test,spec}.{ts,tsx}",
      "!**/*-styles.ts",
      "!**/theme.ts"
    ],
    "coverageDirectory": "../../artifacts/mobile-tests/coverage",
    "coverageThreshold": {
      "global": {
        "branches": 30,
        "functions": 30,
        "lines": 45,
        "statements": 40
      }
    }
  },
  "jest-junit": {
    "outputDirectory": "../../artifacts/mobile-tests",
    "outputName": "junit.xml",
    "uniqueOutputName": "false"
  }
}
