{
  "expo": {
    "name": "VertexADE",
    "slug": "vertexade",
    "scheme": "vertexade",
    "version": "0.0.21",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          },
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow VertexADE to attach images to agent messages."
        }
      ],
      [
        "expo-widgets",
        {
          "enablePushNotifications": true,
          "widgets": [
            {
              "name": "AgentTurnActivity",
              "displayName": "Agent turn",
              "description": "Shows the current VertexADE agent turn.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall"
                ]
              }
            }
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "enableBackgroundRemoteNotifications": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vertexade.mobile",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "com.vertexade.mobile",
      "usesCleartextTraffic": true
    }
  }
}
