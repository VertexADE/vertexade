{
  "name": "vertexade",
  "version": "0.0.1",
  "description": "VertexADE server and web UI bundle",
  "repository": {
    "type": "git",
    "url": "https://github.com/VertexADE/vertexade"
  },
  "license": "MIT",
  "bin": {
    "vertexade": "bin/vertexade.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "pnpm --filter @vertexade/web build && pnpm --filter @vertexade/desktop build:main && node scripts/build.mjs",
    "check": "vp check --no-fmt",
    "test": "vp test run --maxWorkers=2 --passWithNoTests"
  },
  "dependencies": {
    "tslib": "^2.8.1",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "vite-plus": "0.2.6"
  },
  "engines": {
    "node": ">=22.13"
  }
}
